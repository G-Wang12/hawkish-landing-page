# Photon iMessage line (from `cd ts_agent && npm run info` or dashboard)
VITE_IMESSAGE_NUMBER=+1 555 123 4567

# Signup API — defaults to /api/waitlist (Vite dev + Vercel). Override only if using another backend.
# VITE_WAITLIST_URL=/api/waitlist

# Photon Spectrum (server-only — never prefix with VITE_)
# Project Settings → project id + secret
PHOTON_PROJECT_ID=your-project-uuid
PHOTON_PROJECT_SECRET=your-project-secret
# Pro plan uses shared users (default). Business with a dedicated line: PHOTON_USER_TYPE=dedicated
PHOTON_USER_TYPE=shared
# For dedicated only — line users text (E.164). Defaults to VITE_IMESSAGE_NUMBER.
# PHOTON_ASSIGNED_PHONE_NUMBER=+15551234567
